rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se é admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Regra específica para a coleção de usuários: usuários podem editar o próprio perfil, e admins podem editar qualquer um
    match /users/{userId} {
      allow read: if true; 
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Para todo o resto do banco (notícias, colunas, categorias, etc)
    // Leitura é pública, mas escrita é estritamente restrita a administradores.
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
